# 只读目标仓库的本机绝对路径；不设时使用 config/watch.json 中的相对路径。
OSS_WATCH_TARGET_ROOT=E:\code\插件\dsh-reasoning-effort

# 可选：允许只读 GitHub 工具通过本机 gh 查询公开仓库。0 为关闭。
# 不会自动读取或保存 Token，gh 使用你自己的登录配置。
OSS_WATCH_GITHUB=0

# 人工 approve 后才允许发送真实 Issue/PR 的讨论区评论；默认关闭。
# 与在线读取开关独立。模拟事件和版本适配永远不发送，补丁永远只在本地。
# 凭据由本机 gh 管理，不要在仓库写入 Token。
OSS_WATCH_SEND_COMMENTS=0

# 可选：在项目内使用另一份状态，保留原有待拍板演示。
# OSS_WATCH_VAR=E:\code\oss-watch\var\issue-demo

# 可选：覆盖配置文件位置。
# OSS_WATCH_CONFIG=E:\code\oss-watch\config\watch.json
